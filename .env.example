# ==========================================
# Next.js Application Environment Variables
# ==========================================

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="AdminHub"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# API & Backend Services
NEXT_PUBLIC_API_URL="http://localhost:5001"

# Authentication (e.g. NextAuth / Auth.js)
AUTH_SECRET="your-secure-auth-secret-here-min-32-chars"
AUTH_URL="http://localhost:3000"

# Database (e.g. PostgreSQL, Prisma, Drizzle)
# DATABASE_URL="postgresql://user:password@localhost:5432/admin_db?schema=public"
